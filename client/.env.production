# Production Environment Variables
# These will be set during deployment

# Backend API URL (will be updated with Render URL)
REACT_APP_API_URL=https://ai-chatbot-backend.onrender.com/api

# Backend Server URL (will be updated with Render URL)
REACT_APP_SERVER_URL=https://ai-chatbot-backend.onrender.com

# App Configuration
REACT_APP_APP_NAME=Auto-Reply Chatbot
REACT_APP_VERSION=1.0.0
